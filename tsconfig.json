{
  "compilerOptions": {
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "target": "ES2022",
    "module": "ESNext",
    "outDir": "./dist",
    "rootDir": "./",
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals", 
      "node"
    ],
    "moduleResolution": "bundler",
  }
}